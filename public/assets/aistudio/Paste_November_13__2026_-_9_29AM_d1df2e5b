      // Links iniciais WhatsApp
      setWaLink($('nav-wa'), 'Olá! Gostaria de conhecer melhor as soluções de BPO Financeiro da VN Soluções.');
      setWaLink($('fab-wa'), 'Olá! Gostaria de falar com um consultor da VN Soluções.');
      setWaLink($('diag-wa-direct'), 'Olá! Gostaria de agendar uma reunião de diagnóstico completo para minha empresa.');

      // 1. METODOLOGIA (STEPPER)
      const ETAPAS = [
        {
          num: '01',
          icon: 'search',
          titulo: 'Diagnóstico Operacional',
          desc: 'Realizamos uma reunião aprofundada para compreender o modelo de negócio, o volume operacional, os processos atuais e os principais gargalos financeiros da empresa.'
        },
        {
          num: '02',
          icon: 'settings-2',
          titulo: 'Implantação e Estruturação',
          desc: 'Aproveitamos o ERP que sua empresa já utiliza ou implantamos o sistema Omie: cadastros, plano de contas gerencial, permissões de acesso e documentação das rotinas padrão.'
        },
        {
          num: '03',
          icon: 'repeat',
          titulo: 'Operação Diária Recorrente',
          desc: 'Assumimos a execução das rotinas acordadas: lançamentos, conferência e programação de pagamentos, acompanhamento de recebíveis, cobrança e conciliação bancária.'
        },
        {
          num: '04',
          icon: 'line-chart',
          titulo: 'Gestão e Melhoria Contínua',
          desc: 'Entregamos fechamento mensal, fluxo de caixa atualizado e dashboards de indicadores, conduzindo reuniões periódicas de resultados para apoiar suas decisões.'
        }
      ];

      let activeStep = 0;
      function renderSteps() {
        const btnWrap = $('step-buttons');
        const panel = $('step-panel');
        btnWrap.innerHTML = '';

        ETAPAS.forEach((st, idx) => {
          const isSelected = idx === activeStep;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `p-4 rounded-2xl border text-left transition-all cursor-pointer ${
            isSelected 
              ? 'bg-vn-navy text-white border-vn-navy shadow-md' 
              : 'bg-white text-slate-700 border-slate-200 hover:border-vn-blue'
          }`;
          btn.innerHTML = `
            <div class="text-xs font-extrabold ${isSelected ? 'text-vn-orange' : 'text-slate-400'}">ETAPA ${st.num}</div>
            <div class="font-bold text-sm mt-1 truncate">${st.titulo.split(' ')[0]}</div>
          `;
          btn.onclick = () => {
            activeStep = idx;
            renderSteps();
          };
          btnWrap.appendChild(btn);
        });

        const current = ETAPAS[activeStep];
        panel.innerHTML = `
          <div class="flex flex-col sm:flex-row sm:items-center gap-5 fade-in">
            <div class="w-14 h-14 rounded-2xl bg-blue-50 text-vn-navy flex items-center justify-center shrink-0">
              <i data-lucide="${current.icon}" class="w-7 h-7"></i>
            </div>
            <div>
              <div class="text-xs font-extrabold uppercase tracking-wider text-vn-orange">Etapa ${current.num} de 04</div>
              <h3 class="text-xl sm:text-2xl font-extrabold text-vn-navy mt-1">${current.titulo}</h3>
              <p class="text-slate-600 mt-2 leading-relaxed">${current.desc}</p>
            </div>
          </div>
        `;
        lucide.createIcons();
      }
      renderSteps();

      // 2. MINI-DIAGNÓSTICO
      const PERGUNTAS = [
        'Você sabe, hoje, exatamente quanto entra e quanto sai do caixa da empresa por semana?',
        'As contas a pagar e a receber são conferidas e baixadas diariamente com comprovantes organizados?',
        'A conciliação bancária (confronto entre sistema e extrato real) é feita com frequência?',
        'Sua empresa possui um fluxo de caixa projetado para os próximos 30 a 90 dias?',
        'Você recebe relatórios gerenciais ou indicadores claros para tomar decisões estratégicas?'
      ];
      let qIndex = 0;
      let score = 0;

      function renderQuiz() {
        const body = $('diag-body');
        const prog = $('diag-progress');

        if (qIndex >= PERGUNTAS.length) {
          prog.style.width = '100%';
          let nivel = '';
          let resumo = '';
          if (score <= 3) {
            nivel = 'Estágio Inicial · Hora de Estruturar';
            resumo = 'Existem pontos críticos sem visibilidade ou controle diário. Uma implantação organizada trará segurança imediata para a operação.';
          } else if (score <= 7) {
            nivel = 'Estágio Intermediário · Bom Caminho com Lacunas';
            resumo = 'Sua empresa já possui uma base de controle, mas faltam rotinas padronizadas e indicadores para ganhar previsibilidade.';
          } else {
            nivel = 'Estágio Estruturado · Foco em Inteligência';
            resumo = 'Ótima organização! O próximo passo é delegar a execução operacional para liberar seu tempo e aprofundar a análise gerencial.';
          }

          body.innerHTML = `
            <div class="space-y-4 fade-in">
              <div class="inline-block px-3 py-1 rounded-lg bg-vn-orange/20 border border-vn-orange/40 text-vn-orange font-bold text-sm">
                Pontuação: ${score} de 10 pontos
              </div>
              <h3 class="text-2xl font-extrabold text-white">${nivel}</h3>
              <p class="text-blue-100 leading-relaxed">${resumo}</p>
              <div class="pt-3 flex flex-col sm:flex-row gap-3">
                <a id="diag-res-wa" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold bg-vn-orange hover:bg-vn-orangeHover text-white transition-colors cursor-pointer">
                  Agendar Reunião de Diagnóstico
                </a>
                <button type="button" id="diag-restart" class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl font-semibold bg-white/10 hover:bg-white/15 text-white transition-colors cursor-pointer">
                  Refazer Avaliação
                </button>
              </div>
            </div>
          `;
          setWaLink(
            $('diag-res-wa'),
            `Olá! Realizei o mini-diagnóstico no site da VN Soluções (Resultado: ${score}/10 - ${nivel}) e gostaria de agendar o diagnóstico completo.`
          );
          $('diag-restart').onclick = () => {
            qIndex = 0;
            score = 0;
            renderQuiz();
          };
          return;
        }

        prog.style.width = `${(qIndex / PERGUNTAS.length) * 100}%`;
        body.innerHTML = `
          <div class="space-y-5 fade-in">
            <div class="text-xs font-bold uppercase tracking-wider text-blue-200">
              Pergunta ${qIndex + 1} de ${PERGUNTAS.length}
            </div>
            <p class="text-lg sm:text-xl font-bold text-white leading-snug">${PERGUNTAS[qIndex]}</p>
            <div class="grid sm:grid-cols-3 gap-3 pt-1">
              <button type="button" data-pts="2" class="quiz-opt py-3.5 px-4 rounded-xl bg-white/10 hover:bg-vn-orange border border-white/20 hover:border-vn-orange font-bold text-sm text-white transition-all cursor-pointer">
                Sim, totalmente
              </button>
              <button type="button" data-pts="1" class="quiz-opt py-3.5 px-4 rounded-xl bg-white/10 hover:bg-vn-orange border border-white/20 hover:border-vn-orange font-bold text-sm text-white transition-all cursor-pointer">
                Em parte
              </button>
              <button type="button" data-pts="0" class="quiz-opt py-3.5 px-4 rounded-xl bg-white/10 hover:bg-vn-orange border border-white/20 hover:border-vn-orange font-bold text-sm text-white transition-all cursor-pointer">
                Ainda não
              </button>
            </div>
          </div>
        `;

        body.querySelectorAll('.quiz-opt').forEach((btn) => {
          btn.onclick = () => {
            score += Number(btn.getAttribute('data-pts'));
            qIndex++;
            renderQuiz();
          };
        });
      }

      $('diag-start').onclick = () => {
        qIndex = 0;
        score = 0;
        renderQuiz();
      };

      // 3. FORMULÁRIO DE CHAMADOS E PARCERIAS
      function populateSelect() {
        const select = $('tipo');
        select.innerHTML = '';
        const list = mode === 'cliente' ? SERVICOS : PARCERIAS;
        list.forEach((item) => {
          const opt = document.createElement('option');
          opt.value = item;
          opt.textContent = item;
          select.appendChild(opt);
        });
      }

      function switchMode(newMode) {
        mode = newMode;
        const isCliente = mode === 'cliente';
        
        $('mode-cliente').setAttribute('aria-pressed', isCliente);
        $('mode-parceiro').setAttribute('aria-pressed', !isCliente);
        
        $('mode-cliente').className = isCliente
          ? 'px-4 py-1.5 rounded-lg text-xs font-bold transition-all bg-vn-navy text-white cursor-pointer'
          : 'px-4 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-600 hover:text-slate-900 cursor-pointer';
          
        $('mode-parceiro').className = !isCliente
          ? 'px-4 py-1.5 rounded-lg text-xs font-bold transition-all bg-vn-navy text-white cursor-pointer'
          : 'px-4 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-600 hover:text-slate-900 cursor-pointer';

        $('form-title').textContent = isCliente ? 'Abrir Chamado ou Solicitação' : 'Cadastro de Empresa Parceira';
        $('form-sub').textContent = isCliente
          ? 'Preencha os dados para gerar seu código de protocolo.'
          : 'Comércio ou serviço: apresente sua empresa para nossa rede.';
        $('label-tipo').textContent = isCliente ? 'Serviço Desejado *' : 'Segmento da Empresa *';
        $('label-desc').textContent = isCliente ? 'Detalhes da Solicitação *' : 'Sobre sua Empresa e Soluções *';
        $('prioridade-wrap').style.display = isCliente ? 'block' : 'none';
        populateSelect();
      }

      $('mode-cliente').onclick = () => switchMode('cliente');
      $('mode-parceiro').onclick = () => switchMode('parceiro');

      // Clicar nos cards de serviços
      document.querySelectorAll('.sv').forEach((card) => {
        card.onclick = () => {
          switchMode('cliente');
          $('tipo').selectedIndex = Number(card.getAttribute('data-s'));
          $('atendimento').scrollIntoView({ behavior: 'smooth' });
          setTimeout(() => $('nome').focus({ preventScroll: true }), 450);
        };
      });

      // Botão Quero ser parceiro
      $('btn-parceiro').onclick = () => {
        switchMode('parceiro');
        $('atendimento').scrollIntoView({ behavior: 'smooth' });
        setTimeout(() => $('nome').focus({ preventScroll: true }), 450);
      };

      // Máscara WhatsApp e Contador
      $('tel').oninput = function() {
        const d = this.value.replace(/\D/g, '').slice(0, 11);
        let out = d;
        if (d.length > 2) {
          out = `(${d.slice(0, 2)}) ${d.slice(2, d.length > 10 ? 7 : 6)}${d.length > (d.length > 10 ? 7 : 6) ? '-' + d.slice(d.length > 10 ? 7 : 6) : ''}`;
        }
        this.value = out;
      };

      $('desc').oninput = function() {
        $('char-count').textContent = this.value.length;
      };

      function loadChamados() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        } catch (e) {
          return [];
        }
      }

      function saveChamados(arr) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
        } catch (e) {}
      }

      function generateProtocol() {
        const d = new Date();
        const pad = (n) => ('0' + n).slice(-2);
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
        let rand = '';
        for (let i = 0; i < 4; i++) rand += chars.charAt(Math.floor(Math.random() * chars.length));
        return `VN-${String(d.getFullYear()).slice(2)}${pad(d.getMonth() + 1)}${pad(d.getDate())}-${rand}`;
      }

      function renderChamadosList() {
        const list = loadChamados();
        const container = $('chamados-list');
        if (!list.length) {
          container.innerHTML = '<p class="text-xs text-slate-400">Nenhum protocolo gerado neste aparelho ainda.</p>';
          return;
        }
        container.innerHTML = '';
        list.forEach((item, index) => {
          const row = document.createElement('div');
          row.className = 'flex items-center justify-between gap-3 p-3 rounded-xl bg-vn-light border border-slate-200/80 text-xs';
          row.innerHTML = `
            <div>
              <span class="font-extrabold text-vn-navy">${item.proto}</span> &bull; 
              <span class="font-semibold text-slate-700">${item.tipo}</span>
              <div class="text-slate-400 mt-0.5">${item.nome} &bull; ${item.data}</div>
            </div>
            <button type="button" aria-label="Remover" class="text-slate-400 hover:text-red-500 p-1.5 cursor-pointer">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          `;
          row.querySelector('button').onclick = () => {
            const updated = loadChamados();
            updated.splice(index, 1);
            saveChamados(updated);
            renderChamadosList();
          };
          container.appendChild(row);
        });
        lucide.createIcons();
      }

      $('chamado-form').onsubmit = function(e) {
        e.preventDefault();
        const nome = $('nome').value.trim();
        const emp = $('emp').value.trim();
        const telDigits = $('tel').value.replace(/\D/g, '');
        const desc = $('desc').value.trim();
        const err = $('form-err');

        if (nome.length < 2) {
          err.textContent = 'Por favor, informe seu nome.';
          $('nome').focus();
          return;
        }
        if (telDigits.length < 10) {
          err.textContent = 'Informe um número de WhatsApp válido com DDD.';
          $('tel').focus();
          return;
        }
        if (desc.length < 10) {
          err.textContent = 'Por favor, descreva um pouco mais a sua solicitação (mínimo 10 caracteres).';
          $('desc').focus();
          return;
        }

        err.textContent = '';
        const proto = generateProtocol();
        const tipo = $('tipo').value;
        const isCliente = mode === 'cliente';
        const prioridade = isCliente ? document.querySelector('input[name="pr"]:checked').value : 'Parceria';

        const waMsg = [
          `Olá! Sou ${nome}${emp ? ' (' + emp + ')' : ''}.`,
          `${isCliente ? 'Protocolo de Atendimento:' : 'Solicitação de Parceria:'} *${proto}*`,
          `${isCliente ? 'Serviço:' : 'Segmento:'} ${tipo}`,
          isCliente ? `Prioridade: ${prioridade}` : null,
          `Detalhes: ${desc}`,
          `WhatsApp de contato: ${$('tel').value}`
        ].filter(Boolean).join('\n');

        const saved = loadChamados();
        saved.unshift({
          proto,
          nome,
          tipo,
          data: new Date().toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })
        });
        saveChamados(saved.slice(0, 15));

        lastProto = proto;
        $('proto-code').textContent = proto;
        setWaLink($('wa-send-proto'), waMsg);

        $('chamado-form').classList.add('hidden');
        $('mode-switch').classList.add('hidden');
        $('chamado-ok').classList.remove('hidden');
        renderChamadosList();
      };

      $('btn-copy-proto').onclick = function() {
        const btn = this;
        navigator.clipboard?.writeText(lastProto);
        btn.textContent = 'Copiado!';
        setTimeout(() => { btn.textContent = 'Copiar Código'; }, 2000);
      };

      $('btn-novo-chamado').onclick = function() {
        $('chamado-form').reset();
        $('char-count').textContent = '0';
        $('chamado-ok').classList.add('hidden');
        $('chamado-form').classList.remove('hidden');
        $('mode-switch').classList.remove('hidden');
        switchMode('cliente');
      };

      // 4. TUTORIAL INTERATIVO
      const TUTORIALS = {
        chamado: [
          ['Escolha o serviço', 'Selecione a rotina financeira desejada ou abra um chamado direto.'],
          ['Preencha os dados', 'Informe nome, empresa, WhatsApp e descreva a necessidade.'],
          ['Gere o protocolo', 'Receba seu código exclusivo de acompanhamento na hora.'],
          ['Envie ao consultor', 'Clique para encaminhar o protocolo via WhatsApp e iniciar o atendimento.']
        ],
        docs: [
          ['Extratos bancários', 'Envie os arquivos OFX ou PDF originais do banco diariamente (D+1).'],
          ['Contas a pagar', 'Encaminhe boletos, faturas e notas fiscais que aguardam programação.'],
          ['Comprovantes', 'Disponibilize recibos e comprovantes após a aprovação/baixa.'],
          ['Pastas por Ano e Mês', 'Organize na nuvem por período (Ex.: 2026 > 11-NOVEMBRO).']
        ]
      };

      function renderTutorial(tab) {
        const list = $('tutorial-list');
        list.innerHTML = '';
        TUTORIALS[tab].forEach((step, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'w-full text-left flex items-start gap-3 p-3.5 rounded-2xl bg-white border border-slate-200/90 hover:border-vn-blue transition-all cursor-pointer group';
          btn.innerHTML = `
            <span class="step-badge w-7 h-7 rounded-full bg-vn-navy text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5 transition-colors">${idx + 1}</span>
            <div>
              <div class="font-bold text-sm text-slate-900">${step[0]}</div>
              <div class="text-xs text-slate-500 mt-0.5 leading-relaxed">${step[1]}</div>
            </div>
          `;
          btn.onclick = () => {
            const done = btn.classList.toggle('border-emerald-500');
            btn.classList.toggle('bg-emerald-50/40', done);
            const badge = btn.querySelector('.step-badge');
            badge.classList.toggle('bg-emerald-600', done);
            badge.classList.toggle('bg-vn-navy', !done);
            badge.textContent = done ? '✓' : String(idx + 1);
          };
          list.appendChild(btn);
        });

        const isChamado = tab === 'chamado';
        $('tut-chamado').className = isChamado
          ? 'px-3 py-1 rounded-lg text-xs font-bold bg-vn-navy text-white transition-all cursor-pointer'
          : 'px-3 py-1 rounded-lg text-xs font-bold text-slate-600 transition-all cursor-pointer';
        $('tut-docs').className = !isChamado
          ? 'px-3 py-1 rounded-lg text-xs font-bold bg-vn-navy text-white transition-all cursor-pointer'
          : 'px-3 py-1 rounded-lg text-xs font-bold text-slate-600 transition-all cursor-pointer';
      }

      $('tut-chamado').onclick = () => renderTutorial('chamado');
      $('tut-docs').onclick = () => renderTutorial('docs');

      // Inicialização
      switchMode('cliente');
      renderChamadosList();
      renderTutorial('chamado');
    })();
  </script>
</body>
</html>